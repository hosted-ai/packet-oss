generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model ActivityEvent {
  id          String   @id @default(cuid())
  customerId  String   @map("customer_id")
  type        String
  description String
  metadata    String?  @db.Text
  tenantId    String   @default("default") @map("tenant_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([customerId])
  @@index([createdAt])
  @@index([tenantId])
  @@map("activity_event")
}

// LEGACY — replaced by User + TeamMembership + TeamInvitation (PA-175).
// Renamed from `team_member` to `team_member_legacy` in the PA-175 schema migration.
// Kept for one release as a rollback safety net; data is read-only.
// To be dropped in the release AFTER PA-175 PR 1 ships clean.
model TeamMemberLegacy {
  id               String    @id @default(cuid())
  email            String
  name             String?
  stripeCustomerId String    @map("stripe_customer_id")
  role             String    @default("member")
  invitedAt        DateTime  @default(now()) @map("invited_at")
  acceptedAt       DateTime? @map("accepted_at")
  invitedBy        String?   @map("invited_by")
  tenantId         String    @default("default") @map("tenant_id")

  @@unique([email, stripeCustomerId])
  @@index([email])
  @@index([stripeCustomerId])
  @@index([tenantId])
  @@map("team_member_legacy")
}

// PA-175: Team RBAC — User, TeamMembership, TeamInvitation, TeamAuditLog
//
// Architecture: Packet owns the role enum; HAI gets a derived coarser role.
// See docs/designs/team-rbac.md for the full model and rationale.
//
//  ┌────────────┐         ┌────────────────────────┐         ┌────────────────────┐
//  │   User     │ ◄─────▶ │   TeamMembership       │ ◄─────▶ │  stripe_customer   │
//  │ (id, email)│ 1:N     │ (role, is_owner, ...)  │ N:1     │ (the "account")    │
//  └────────────┘         └────────────────────────┘         └────────────────────┘
//                                  │
//                                  │ logs to
//                                  ▼
//                         ┌────────────────────────┐
//                         │  TeamAuditLog          │
//                         │ (append-only, 90d TTL) │
//                         └────────────────────────┘
//
//                         ┌────────────────────────┐
//                         │  TeamInvitation        │
//                         │ (pending until accept) │
//                         └────────────────────────┘

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  memberships TeamMembership[]

  @@index([email])
  @@map("user")
}

// One row per (user, account). `role` is Packet's enum; HAI side gets a
// derived role via getHaiRoleForPacketRole(). `is_owner` is Packet-owned
// (HAI doesn't track team-creator) — exactly one is_owner=TRUE per account.
//
// Status lifecycle:
//   pending  → invited but membership row not yet created (rarely used; most
//              invites use team_invitation table)
//   active   → can use the account subject to role
//   revoked  → removed; revoked_at is set; can() denies all
model TeamMembership {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  stripeCustomerId String    @map("stripe_customer_id")
  role             String // 'admin' | 'member' | 'readOnlyMember' | 'financeManager'
  isOwner          Boolean   @default(false) @map("is_owner")
  invitedByUserId  String?   @map("invited_by_user_id")
  invitedAt        DateTime  @default(now()) @map("invited_at")
  acceptedAt       DateTime? @map("accepted_at")
  revokedAt        DateTime? @map("revoked_at")
  status           String    @default("active") // 'active' | 'revoked'
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, stripeCustomerId])
  @@index([stripeCustomerId, status])
  @@index([stripeCustomerId, isOwner])
  @@index([stripeCustomerId, revokedAt])
  @@map("team_membership")
}

// Pending invitations. State machine: pending → accepted | expired | revoked.
// Token is 32 bytes hex (64 chars), generated by crypto.randomBytes(32).hexString.
// Hashing at rest is deferred to v1.5 (filed in TODOS.md).
model TeamInvitation {
  id               String    @id @default(cuid())
  stripeCustomerId String    @map("stripe_customer_id")
  email            String
  role             String // PacketRole — same set as TeamMembership.role
  token            String    @unique
  invitedByUserId  String    @map("invited_by_user_id")
  inviteeName      String?   @map("invitee_name") @db.VarChar(255) // Optional display name supplied by inviter; populated to User.displayName on accept.
  expiresAt        DateTime  @map("expires_at")
  acceptedAt       DateTime? @map("accepted_at")
  status           String    @default("pending") // 'pending' | 'accepted' | 'expired' | 'revoked'
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([stripeCustomerId, email]) // Prevent duplicate pending invites for same email on same account
  @@index([stripeCustomerId, status])
  @@index([expiresAt])
  @@map("team_invitation")
}

// Append-only audit trail for all permission-relevant events:
//   - Invite sent / accepted / revoked / expired
//   - Role changed
//   - Member removed
//   - Ownership transferred
//   - 403 denial on a gated route (only for sensitive perms)
//
// Payload is opaque JSON; consumers should not rely on a strict schema beyond
// the action type. 90-day TTL via cleanup cron (see PR 2).
model TeamAuditLog {
  id               String   @id @default(cuid())
  stripeCustomerId String   @map("stripe_customer_id")
  actorUserId      String?  @map("actor_user_id") // null for system actions
  subjectUserId    String?  @map("subject_user_id") // who the action was about
  action           String // 'invite.sent', 'membership.role_changed', 'permission.denied', etc.
  payload          String?  @db.Text // JSON, opaque to consumers
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([stripeCustomerId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([subjectUserId, createdAt])
  @@index([action])
  @@map("team_audit_log")
}

model Investor {
  id                  String    @id @default(cuid())
  email               String    @unique
  addedBy             String    @map("added_by")
  isOwner             Boolean   @default(false) @map("is_owner")
  acceptedAt          DateTime? @map("accepted_at")
  lastLoginAt         DateTime? @map("last_login_at")
  assignedNodeIds     String    @default("[]") @map("assigned_node_ids") @db.Text
  revenueSharePercent Float?    @map("revenue_share_percent")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([email])
  @@map("investor")
}

model SSHKey {
  id               String   @id @default(cuid())
  stripeCustomerId String   @map("stripe_customer_id")
  // PA-175 PR 2.5: user_id is the User who owns this key. Nullable for
  // backfilled rows where we can't attribute ownership (legacy keys that
  // pre-date team membership). The per-user SSH key removal job operates
  // on this column — keys with userId=null stay in place when a member
  // is removed.
  userId           String?  @map("user_id")
  name             String
  publicKey        String   @map("public_key") @db.Text
  fingerprint      String
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([stripeCustomerId, fingerprint])
  @@index([stripeCustomerId])
  @@index([userId])
  @@map("ssh_key")
}

model PodMetadata {
  id                   String    @id @default(cuid())
  subscriptionId       String    @unique @map("subscription_id")
  instanceId           String?   @unique @map("instance_id") // HostedAI 2.2 unified instance UUID
  stripeCustomerId     String    @map("stripe_customer_id")
  displayName          String?   @map("display_name")
  notes                String?   @db.Text
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deployTime           DateTime? @map("deploy_time")
  hourlyRateCents      Int?      @map("hourly_rate_cents")
  poolId               String?   @map("pool_id")
  prepaidAmountCents   Int?      @map("prepaid_amount_cents")
  prepaidUntil         DateTime? @map("prepaid_until")
  productId            String?   @map("product_id")
  metricsToken         String?   @map("metrics_token")
  startupScript        String?   @map("startup_script") @db.Text // Custom startup script to run after pod starts
  startupScriptStatus  String?   @map("startup_script_status") // "pending", "running", "completed", "failed"
  startupScriptOutput  String?   @map("startup_script_output") @db.Text // Output/error from script execution
  deployStatus         String?   @map("deploy_status") // "provisioning", "running", "failed_refunded" — tracks whether HAI actually started the pod after createInstance (PA-158)
  deployStatusReason   String?   @map("deploy_status_reason") @db.Text // Failure reason when deployStatus=failed_refunded
  storageAlertSent     Boolean   @default(false) @map("storage_alert_sent") // Whether 80% /workspace (persistent) storage warning was sent
  rootStorageAlertPercent Int    @default(0) @map("root_storage_alert_percent") // PA-80: highest ephemeral (local root disk) usage tier alerted — 0, 80, or 90 — so each tier emails once
  skypilotTags         String?   @map("skypilot_tags") @db.Text // JSON tags for SkyPilot cluster tracking (e.g. {"skypilot-cluster-name": "my-cluster"})
  billingType          String?   @map("billing_type") // "hourly" or "monthly" - null for legacy pods
  stripeSubscriptionId String?   @map("stripe_subscription_id") // Links monthly pod to the Stripe subscription that pays for it
  sharedVolumeId       Int?      @map("shared_volume_id") // hosted.ai shared volume ID for persistent workspace
  tenantId             String    @default("default") @map("tenant_id")
  tenantLastBilledAt   DateTime? @map("tenant_last_billed_at") // Last time this pod was billed via tenant wallet
  productName          String?   @map("product_name") // Verbatim product name snapshot at deploy time (e.g. "1 x NVIDIA B200 Dedicated On-Demand")
  provisioningCompletedAt DateTime? @map("provisioning_completed_at") // When HAI confirmed the pod is running
  paymentFailedAt      DateTime? @map("payment_failed_at") // PA-361: start of the 24h grace window after a failed monthly subscription payment; set on the first invoice.payment_failed, cleared on recovery, swept for termination after 24h
  terminateAttempts    Int       @default(0) @map("terminate_attempts") // How many times the failed-survivor sweep has re-issued the HAI delete for this pod
  terminateConfirmedAt DateTime? @map("terminate_confirmed_at") // When HAI first 404'd the instance — the sweep stops selecting the row once set

  @@index([stripeCustomerId])
  @@index([prepaidUntil])
  @@index([metricsToken])
  @@index([stripeSubscriptionId])
  @@index([tenantId])
  @@index([deployStatus])
  @@index([paymentFailedAt])
  // 'engine' rows are launched and billed by packet-api's instance engine;
  // every billing/lifecycle sweep here must skip them.
  managedBy String @default("monolith") @map("managed_by") @db.VarChar(12)

  @@map("pod_metadata")
}

/// PA-354: durable record of monthly-billed subscriptions for investor revenue.
/// Monthly pods bill through Stripe subscriptions (no wallet_transaction rows) and
/// their pod_metadata row is hard-deleted at termination — this table is the ONLY
/// local evidence a monthly subscription existed. One row per POD window (a
/// quantity-N Stripe subscription has N pods → N rows, each at the per-unit
/// price): opened at deploy (endedAt = null), closed at termination. priceCents
/// is the customer's actual Stripe contracted unit price (customers pay
/// different amounts for the same pool — never substitute a gpu_product price).
model SubscriptionHistory {
  id                   String    @id @default(cuid())
  stripeCustomerId     String    @map("stripe_customer_id")
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  podSubscriptionId    String?   @map("pod_subscription_id") // pod_metadata.subscriptionId — the per-pod key
  poolId               Int?      @map("pool_id") // null when deploy couldn't resolve a pool; backfilled at close
  startedAt            DateTime  @map("started_at")
  endedAt              DateTime? @map("ended_at") // null = still active
  billingType          String    @map("billing_type") // "monthly"
  priceCents           Int       @map("price_cents")

  @@index([stripeCustomerId])
  @@index([poolId, startedAt])
  @@index([stripeSubscriptionId])
  @@index([podSubscriptionId])
  @@map("subscription_history")
}

/// PA-206: shared volumes scheduled for deferred deletion after an
/// out-of-balance termination. Instead of deleting a team's storage in the
/// same sync pass that terminates their pods, sync stamps a row here with a
/// grace window; the cleanup-expired-volumes cron deletes the volume once the
/// window passes — unless the customer has topped up in the meantime, in which
/// case the row is dropped and the storage kept. There is no local shared-volume
/// table (volumes live HAI-side, keyed by volume id), so the schedule lives here.
model PendingVolumeDeletion {
  id               String   @id @default(cuid())
  volumeId         Int      @unique @map("volume_id") // hosted.ai shared volume id
  volumeName       String?  @map("volume_name")
  teamId           String   @map("team_id")
  stripeCustomerId String   @map("stripe_customer_id")
  reason           String   @default("negative_balance")
  scheduledFor     DateTime @map("scheduled_for") // eligible for deletion at/after this time
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([scheduledFor])
  @@index([stripeCustomerId])
  @@map("pending_volume_deletions")
}

model PodFailureAlert {
  id             String   @id @default(cuid())
  subscriptionId String   @map("subscription_id")
  podName        String   @map("pod_name")
  teamId         String   @map("team_id")
  customerEmail  String?  @map("customer_email")
  poolName       String?  @map("pool_name")
  podStatus      String   @map("pod_status") // The failed status that triggered the alert
  zammadTicketId Int?     @map("zammad_ticket_id") // Zammad ticket ID if created
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([subscriptionId, podName]) // One alert per pod per subscription
  @@index([teamId])
  @@index([createdAt])
  @@map("pod_failure_alert")
}

model HuggingFaceDeployment {
  id               String   @id @default(cuid())
  subscriptionId   String   @map("subscription_id")
  stripeCustomerId String   @map("stripe_customer_id")
  hfItemId         String   @map("hf_item_id")
  hfItemType       String   @map("hf_item_type")
  hfItemName       String   @map("hf_item_name")
  deployScript     String   @map("deploy_script") @db.Text
  status           String   @default("pending")
  deployOutput     String?  @map("deploy_output") @db.Text
  servicePort      Int?     @map("service_port")
  webUiPort        Int?     @map("web_ui_port")
  openWebUI        Boolean  @default(false) @map("open_web_ui")
  netdataPort      Int?     @map("netdata_port")
  netdata          Boolean  @default(false)
  hfToken          String?  @map("hf_token")
  errorMessage     String?  @map("error_message")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([stripeCustomerId])
  @@index([subscriptionId])
  @@index([status])
  @@map("hugging_face_deployment")
}

model TwoFactorAuth {
  id          String    @id @default(cuid())
  email       String    @unique
  secret      String
  verified    Boolean   @default(false)
  backupCodes String?   @map("backup_codes") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  lastUsedAt  DateTime? @map("last_used_at")

  @@index([email])
  @@map("two_factor_auth")
}

model AdminPin {
  id             String   @id @default(cuid())
  email          String   @unique
  pinHash        String   @map("pin_hash")
  salt           String
  expiresAt      DateTime @map("expires_at")
  previousHashes String?  @map("previous_hashes") @db.Text // JSON array of {salt, hash} for reuse prevention
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("admin_pin")
}

model AdminActivityEvent {
  id          String   @id @default(cuid())
  adminEmail  String   @map("admin_email")
  type        String
  description String
  metadata    String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([adminEmail])
  @@index([createdAt])
  @@index([type])
  @@map("admin_activity_event")
}

model VllmMetrics {
  id                    String   @id @default(cuid())
  subscriptionId        String   @map("subscription_id")
  stripeCustomerId      String   @map("stripe_customer_id")
  promptTokens          BigInt   @map("prompt_tokens")
  generationTokens      BigInt   @map("generation_tokens")
  totalTokens           BigInt   @map("total_tokens")
  promptTokensDelta     BigInt   @default(0) @map("prompt_tokens_delta")
  generationTokensDelta BigInt   @default(0) @map("generation_tokens_delta")
  totalTokensDelta      BigInt   @default(0) @map("total_tokens_delta")
  walletBalanceCents    Int?     @map("wallet_balance_cents")
  createdAt             DateTime @default(now()) @map("created_at")

  @@index([subscriptionId, createdAt])
  @@index([stripeCustomerId, createdAt])
  @@map("vllm_metrics")
}

model ReferralCode {
  id               String          @id @default(cuid())
  code             String          @unique
  stripeCustomerId String          @unique @map("stripe_customer_id")
  createdAt        DateTime        @default(now()) @map("created_at")
  claims           ReferralClaim[]

  @@index([stripeCustomerId])
  @@index([code])
  @@map("referral_code")
}

model ReferralClaim {
  id                String       @id @default(cuid())
  referralCodeId    String       @map("referral_code_id")
  refereeCustomerId String       @unique @map("referee_customer_id")
  refereeEmail      String       @map("referee_email")
  status            String       @default("pending")
  qualifiedAt       DateTime?    @map("qualified_at")
  creditedAt        DateTime?    @map("credited_at")
  referrerCredited  Boolean      @default(false) @map("referrer_credited")
  refereeCredited   Boolean      @default(false) @map("referee_credited")
  createdAt         DateTime     @default(now()) @map("created_at")
  referralCode      ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)

  @@index([referralCodeId])
  @@index([status])
  @@map("referral_claim")
}

model Voucher {
  id              String              @id @default(cuid())
  code            String              @unique
  name            String
  description     String?
  creditCents     Int                 @map("credit_cents")
  minTopupCents   Int?                @map("min_topup_cents")
  maxRedemptions  Int?                @map("max_redemptions")
  redemptionCount Int                 @default(0) @map("redemption_count")
  maxPerCustomer  Int                 @default(1) @map("max_per_customer")
  startsAt        DateTime?           @map("starts_at")
  expiresAt       DateTime?           @map("expires_at")
  active          Boolean             @default(true)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  createdBy       String?             @map("created_by")
  redemptions     VoucherRedemption[]

  @@index([code])
  @@index([active])
  @@map("voucher")
}

model VoucherRedemption {
  id               String   @id @default(cuid())
  voucherId        String   @map("voucher_id")
  stripeCustomerId String   @map("stripe_customer_id")
  customerEmail    String   @map("customer_email")
  topupCents       Int      @map("topup_cents")
  creditCents      Int      @map("credit_cents")
  stripeSessionId  String?  @map("stripe_session_id")
  createdAt        DateTime @default(now()) @map("created_at")
  tenantId         String   @default("default") @map("tenant_id")
  voucher          Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([voucherId])
  @@index([stripeCustomerId])
  @@index([createdAt])
  @@index([tenantId])
  @@map("voucher_redemption")
}

model PodSnapshot {
  id                     String    @id @default(cuid())
  stripeCustomerId       String    @map("stripe_customer_id")
  displayName            String    @map("display_name")
  notes                  String?
  snapshotType           String    @default("template") @map("snapshot_type")
  originalSubscriptionId String?   @map("original_subscription_id")
  poolId                 String    @map("pool_id")
  poolName               String?   @map("pool_name")
  regionId               String?   @map("region_id")
  vgpus                  Int
  instanceTypeId         String?   @map("instance_type_id")
  imageUuid              String?   @map("image_uuid")
  persistentVolumeId     Int?      @map("persistent_volume_id")
  persistentVolumeName   String?   @map("persistent_volume_name")
  persistentVolumeSize   Int?      @map("persistent_volume_size")
  autoCreatedVolume      Boolean   @default(false) @map("auto_created_volume")
  storageBlockId         String?   @map("storage_block_id")
  hfItemId               String?   @map("hf_item_id")
  hfItemType             String?   @map("hf_item_type")
  hfItemName             String?   @map("hf_item_name")
  deployScript           String?   @map("deploy_script") @db.Text
  autoPreserved          Boolean   @default(false) @map("auto_preserved") // Auto-created on non-payment termination
  expiresAt              DateTime? @map("expires_at") // When auto-preserved snapshot should be cleaned up (7 days)
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@index([stripeCustomerId])
  @@index([snapshotType])
  @@index([createdAt])
  @@index([expiresAt])
  @@map("pod_snapshot")
}

model SupportNotification {
  id               String   @id @default(cuid())
  ticketId         String   @map("ticket_id") // Zammad ticket ID (as string for compatibility)
  stripeCustomerId String   @map("stripe_customer_id")
  customerEmail    String   @map("customer_email")
  lastArticleId    Int      @map("last_article_id") // Zammad article ID
  lastArticleAt    DateTime @map("last_article_at")
  sentAt           DateTime @default(now()) @map("sent_at")

  @@unique([ticketId, lastArticleId])
  @@index([ticketId])
  @@index([stripeCustomerId])
  @@map("support_notification")
}

model ContactSubmission {
  id               String   @id @default(cuid())
  name             String
  email            String
  subject          String
  message          String   @db.Text
  priority         String   @default("normal")
  stripeCustomerId String?  @map("stripe_customer_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("contact_submissions")
}

model ApiKey {
  id                   String    @id @default(cuid())
  name                 String
  keyPrefix            String    @map("key_prefix")
  keyHash              String    @unique @map("key_hash")
  stripeCustomerId     String    @map("stripe_customer_id")
  teamId               String    @map("team_id")
  scopes               String    @default("*")
  lastUsedAt           DateTime? @map("last_used_at")
  expiresAt            DateTime? @map("expires_at")
  rateLimitRpm         Int?      @map("rate_limit_rpm") // Per-key RPM override (null = use customer default)
  createdAt            DateTime  @default(now()) @map("created_at")
  revokedAt            DateTime? @map("revoked_at")
  // PA-175 PR 2.5: holderUserId is the User the key was issued by — when the
  // holder's role changes, recomputeApiKeyPermissions writes the new
  // permission snapshot to effectivePermissions. Nullable for legacy keys
  // (treated as "no holder; permissions come from the account Owner").
  holderUserId         String?   @map("holder_user_id")
  // JSON-encoded array of Permission strings, e.g. '["gpu.provision","gpu.access"]'.
  // Token Factory + other API-key-authed routes read this column once (no joins)
  // when validating a request. AC #3 of PA-175 requires updates ≤5s after a
  // role change.
  effectivePermissions String?   @map("effective_permissions") @db.Text

  @@index([stripeCustomerId])
  @@index([keyHash])
  @@index([holderUserId])
  @@map("api_key")
}

model ServiceProvider {
  id                      String                    @id @default(cuid())
  email                   String                    @unique
  companyName             String                    @map("company_name")
  contactName             String                    @map("contact_name")
  phone                   String?
  website                 String?
  verified                Boolean                   @default(false)
  verifiedAt              DateTime?                 @map("verified_at")
  verifiedBy              String?                   @map("verified_by")
  estimatedGpuCount       Int?                      @map("estimated_gpu_count")
  gpuTypes                String?                   @map("gpu_types")
  regions                 String?
  applicationType         String                    @default("gpu_provider") @map("application_type") // "gpu_provider" or "white_label"
