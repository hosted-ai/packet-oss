  enrolledAt       DateTime  @default(now()) @map("enrolled_at")
  lastSentAt       DateTime? @map("last_sent_at")
  completedAt      DateTime? @map("completed_at")
  cancelledAt      DateTime? @map("cancelled_at")
  metadata         String?   @db.Text // JSON for extra context (e.g. signup_gpu)
  tenantId         String    @default("default") @map("tenant_id")

  sequence DripSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, stripeCustomerId])
  @@index([sequenceId, status])
  @@index([stripeCustomerId])
  @@index([status, lastSentAt])
  @@index([tenantId])
  @@map("drip_enrollment")
}

