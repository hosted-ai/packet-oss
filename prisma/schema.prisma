// PA-267: persistent customer sessions. The httpOnly refresh cookie carries a
// refresh JWT whose jti is sha256-hashed into `tokenHash`. This row is the
// revocable source of truth for a rolling 15-day session, capped at 30 days
// absolute. The short-lived access token (existing Bearer flow) is minted from
// a live row, so logout / "log out everywhere" actually kill the session.
model CustomerSession {
  id                String    @id @default(cuid())
  tokenHash         String    @unique @map("token_hash") @db.VarChar(64) // sha256(jti) hex
  stripeCustomerId  String    @map("stripe_customer_id")
  userId            String?   @map("user_id")
  email             String    @db.VarChar(255)
  createdAt         DateTime  @default(now()) @map("created_at")
  expiresAt         DateTime  @map("expires_at") // rolling: min(now + 15d, absoluteExpiresAt)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") // createdAt + 30d hard cap
  revokedAt         DateTime? @map("revoked_at")
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at")
  userAgent         String?   @map("user_agent") @db.Text
  ip                String?   @map("ip") @db.VarChar(64)

  @@index([stripeCustomerId])
  @@index([userId])
  @@index([expiresAt])
  @@map("customer_session")
}

// PA-380: single-use, short-lived sign-in / invitation links.
//
// Emailed magic links (/dashboard?token=<jwt>) carry a random `jti`; this row
// keys off sha256(jti) and is the server-side authority the stateless JWT lacks:
//   - short expiry  → `expires_at` (JWT `exp` mirrors it)
//   - invalidate-prior-on-issue → `superseded_at` (set on all live rows for the
//     same email+account when a newer link is minted)
//   - single-use → `consumed_at` (set once the link establishes a session)
// The persistent session (customer_session) and the Bearer access token it mints
// are unaffected — only the emailed link is gated here.
model LoginLink {
  id               String    @id @default(cuid())
  tokenHash        String    @unique @map("token_hash") @db.VarChar(64) // sha256(jti) hex
  email            String    @db.VarChar(255)
  stripeCustomerId String    @map("stripe_customer_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  expiresAt        DateTime  @map("expires_at")
  consumedAt       DateTime? @map("consumed_at") // set when the link authenticates (single-use)
  supersededAt     DateTime? @map("superseded_at") // set when a newer link is issued for the same email+account

  @@index([email, stripeCustomerId])
  @@index([expiresAt])
  @@map("login_link")
}

// ============================================
// Token Factory - Batch & Real-time Inference
