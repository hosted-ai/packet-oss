// ─── Email Broadcasts (admin mass email) ───
model EmailBroadcast {
  id             String    @id @default(cuid())
  subject        String
  htmlBody       String    @map("html_body") @db.LongText
  textBody       String?   @map("text_body") @db.LongText
  useLayout      Boolean   @default(true) @map("use_layout") // wrap in emailLayout() or send raw HTML
  segmentType    String    @default("all") @map("segment_type") // all | active | pool | node | billing | product | custom
  segmentFilter  String?   @map("segment_filter") // JSON: {"poolIds":[59]}, {"billingType":"monthly"}, {"emails":["a@b.com"]}
  recipientCount Int       @default(0) @map("recipient_count")
