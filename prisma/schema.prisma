  billingCustomerId    String?   @map("billing_customer_id")
  teamId               String    @map("team_id")
  name                 String?
  provider             String // e.g. tensordock, voltagepark
  gpuType              String    @map("gpu_type") // e.g. rtx-4090, h100
  gpuCount             Int       @default(1) @map("gpu_count")
  region               String
  operatingSystem      String    @map("operating_system")
  instanceType         String    @map("instance_type") // DEDICATED, SPOT, BARE_METAL
  offerId              String    @map("offer_id")
  status               String    @default("deploying") // deploying, running, failed, terminated
  ipAddress            String?   @map("ip_address")
  sshUser              String?   @map("ssh_user")
  sshCommand           String?   @map("ssh_command")
  hourlyPriceCents     Int       @map("hourly_price_cents") // Spheron price in cents
  markupPercent        Int       @default(15) @map("markup_percent") // Our markup percentage
  totalHourlyRateCents Int       @map("total_hourly_rate_cents") // Final price to customer (price + markup)
  lastBilledAt         DateTime? @map("last_billed_at") // When the last hourly charge was applied
  // Kubernetes add-on fields
  k8sEnabled           Boolean   @default(false) @map("k8s_enabled")
  k8sVersion           String?   @map("k8s_version") // e.g. "1.35"
  k8sClusterId         String?   @map("k8s_cluster_id") // Spheron cluster ID for health checks
