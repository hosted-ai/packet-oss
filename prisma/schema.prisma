// Bare-metal product catalog — admin-managed pricing authority for term-prepay
// orders, with a 1:1 mapping to a HAI service of type "baremetal_gpu" (mirrors
// GpuProduct ↔ pod_accelerator service). Provisioning passes haiServiceId as
// service_id to POST /baremetal/instances, the same way the HAI user panel
// provisions baremetal through a service.
model BareMetalProduct {
  id     String  @id @default(cuid())
  label  String // display name in the order form
  active Boolean @default(true)

  // How the customer pays for this product:
  //  - "stripe_invoice": Stripe invoice payable by US wire (customer_balance),
  //    auto-reconciled, webhook flips the order to payment_received.
  //  - "manual_bank": customer wires directly to Packet's bank account
  //    (details from Platform Settings BAREMETAL_BANK_DETAILS), uploads a
  //    receipt, and an admin confirms payment manually. No Stripe fee line.
  paymentMode String @default("stripe_invoice") @map("payment_mode")

  // 1:1 HAI service mapping (service_type must be "baremetal_gpu")
  haiServiceId String @unique @map("hai_service_id")

  // Server spec (display values shown to the customer). No region here —
  // products are abstract; the customer picks a region at order time from
  // HAI's live compatible regions for the service.
  gpuType         String @map("gpu_type") // display, e.g. "NVIDIA B200 192GB"
  haiGpuType      String @map("hai_gpu_type") // HAI short form, e.g. "B200"
  gpuCount        Int    @default(1) @map("gpu_count")
  // How many servers this product provisions (sent as HAI `quantity`). Distinct
  // from gpuCount (GPUs PER server). Price is a fixed bundle total for all N.
  serverCount     Int    @default(1) @map("server_count")
  cpuCores        Int    @map("cpu_cores")
  ramGb           Int    @map("ram_gb")
  storageGb       Int    @map("storage_gb")
  storageType     String @default("NVMe SSD") @map("storage_type")
  operatingSystem String @default("Ubuntu 22.04") @map("operating_system")

  // Pricing (cents) — Packet's customer-facing price; PO/finance sets this.
  // termPricing is a JSON array of {months, priceCents} where priceCents is
  // the TOTAL server price for that term (NOT a monthly rate — finance quotes
  // term totals like "$70k for 3 months" that integer monthly cents can't
  // express). Setup fee and processing fee are added on top.
  termPricing   String @map("term_pricing") @db.Text
  setupFeeCents Int    @default(0) @map("setup_fee_cents")

  // Optional provisioning overrides — sent to POST /baremetal/instances when
  // set (instance_type_id / image_id, both *uint in HAI's payload). Normally
  // these are locked in the HAI service like GPU products, but HAI bugs
  // currently prevent locking them on baremetal_gpu services; these fields
  // are the workaround. Read at PROVISION time (not order time) so ops can
  // fix a product and retry a stuck paid order.
  haiInstanceTypeId Int? @map("hai_instance_type_id")
  haiImageId        Int? @map("hai_image_id")

  displayOrder Int      @default(0) @map("display_order")
  createdBy    String?  @map("created_by")
  updatedBy    String?  @map("updated_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([active])
  @@index([displayOrder])
  @@map("bare_metal_product")
}

// Bare-metal term-prepay order (B200 etc) — invoice-based flow.
// Customer picks a server + N-month term and pays the whole term upfront via a
// Stripe invoice (customer_balance / US wire). When funds reconcile,
// invoice.payment_succeeded flips the order to payment_received; provisioning
// then goes through HAI POST /baremetal/instances (src/lib/hostedai/baremetal.ts).
// Field shape follows the PO design on branch baremetal_anamitra so its
// customer/admin UI ports cleanly; the stripe*/hai* fields are the real-engine
// additions. Status flow: invoice_generated → wire_transfer_pending →
// payment_received → provisioning → provisioned → active (→ terminated).
// See docs/baremetal-term-prepay-plan.md.
model BareMetalOrder {
  id               String @id @default(cuid())
  stripeCustomerId String @map("stripe_customer_id")
  email            String
  teamId           String @map("team_id") // HAI team UUID ("" until resolved at provisioning)

  // Server specification (display values, sourced from the server-side catalog)
  catalogId       String? @map("catalog_id") // BAREMETAL_CATALOG item id
  gpuType         String  @map("gpu_type") // display, e.g. "NVIDIA B200 192GB"
  gpuCount        Int     @map("gpu_count")
  cpuCores        Int     @map("cpu_cores")
  ramGb           Int     @map("ram_gb")
  storageGb       Int     @map("storage_gb")
  storageType     String  @default("NVMe SSD") @map("storage_type")
  region          String
  operatingSystem String  @default("Ubuntu 22.04") @map("operating_system")
  contractMonths  Int     @default(1) @map("contract_months")
  // Snapshot of the product's server count (N HAI instances for this order).
  // Price is a fixed bundle total for all N (not multiplied).
  serverCount     Int     @default(1) @map("server_count")
  // One row per provisioned HAI instance (multi-server orders). The order's
  // scalar ssh/hai* columns remain as the denormalised "primary" (server[0]).
  servers         BareMetalServer[]

  // Pricing (cents). totalInvoiceCents is the EXACT amount the customer must
  // wire (term price + setup + processing fee) — Stripe reconciliation
  // requires an exact match against the invoice amount_due. termPriceCents is
  // the snapshot of the chosen term's total server price from the product.
  termPriceCents        Int @map("term_price_cents")
  setupFeeCents         Int @default(0) @map("setup_fee_cents")
  stripeInvoiceFeeCents Int @default(700) @map("stripe_invoice_fee_cents") // flat processing fee, its own invoice line
  totalInvoiceCents     Int @map("total_invoice_cents")

  // Invoice
  invoiceNumber       String   @unique @map("invoice_number") // internal display ref INV-BM-YYYY-XXXXXX
  invoiceDate         DateTime @default(now()) @map("invoice_date")
  invoicePdfUrl       String?  @map("invoice_pdf_url")
  stripeInvoiceId     String?  @unique @map("stripe_invoice_id")
  stripeInvoiceNumber String?  @map("stripe_invoice_number") // Stripe's number — the wire reference on the hosted page
  hostedInvoiceUrl    String?  @map("hosted_invoice_url") @db.Text

  // Status: invoice_generated, wire_transfer_pending, payment_received,
  // provisioning, active, expired, terminated, cancelled, refund_pending, refunded.
  // (provisioned was collapsed into active in Phase 1.)
  status String @default("invoice_generated")

  // Payment mode snapshot from the product at order time (see BareMetalProduct)
  paymentMode String @default("stripe_invoice") @map("payment_mode")

  // Wire transfer
  wireTransferRef     String?   @map("wire_transfer_ref")
  wireTransferDate    DateTime? @map("wire_transfer_date")
  paymentReceivedDate DateTime? @map("payment_received_date")
  // Stripe reported the invoice paid (amount-verified webhook), but an admin has
  // NOT yet confirmed. Provisioning is gated on a human "Confirm Payment Received"
  // (or "Cancel & refund"); this only records that the money landed.
  stripeReportedPaidAt DateTime? @map("stripe_reported_paid_at")
  // PA-821: an admin recorded payment via the backfill override, bypassing Stripe
  // verification (e.g. the customer deducted bank fees, so amount_paid never
  // matched amount_due and reconciliation could not complete). This is what makes
  // an overridden payment distinguishable from a normally-reconciled one; the
  // actor and the Stripe invoice state at the time live in the audit record.
  // Deliberately does NOT advance `status`: an override-paid order must stay
  // invisible to the provisioning poller (which keys on status="payment_received").
  paymentOverrideAt DateTime? @map("payment_override_at")

  // Provisioning (HAI)
  estimatedProvisionDate DateTime? @map("estimated_provision_date")
  provisionedDate        DateTime? @map("provisioned_date")
  // PA-822: activated through the admin backfill flow rather than normal
  // provisioning — the hardware was already in the customer's hands, so the dates
  // are the real (backdated) handover dates and no handover email was sent.
  backfilledAt           DateTime? @map("backfilled_at")
  haiSubscriptionId      String?   @map("hai_subscription_id") // HAI BaremetalSubscription id
  haiInstanceId          String?   @map("hai_instance_id") // unified i-{uuid}
  haiRegionId            Int?      @map("hai_region_id")
  haiServiceId           String?   @map("hai_service_id")
  provisionError         String?   @map("provision_error") @db.Text
  stuckAlertedAt         DateTime? @map("stuck_alerted_at") // one-shot ops alarm past estimatedProvisionDate

  // Contract lifecycle (Phase 2). expiresAt is stamped at activation
  // (provisionedDate + contractMonths) by activateOrder() and is ops-editable.
  expiresAt                 DateTime? @map("expires_at")
  lastTerminationReminderOn DateTime? @map("last_termination_reminder_on") // date-only guard — reminders fire once/day in the final week
  expiryAlertedAt           DateTime? @map("expiry_alerted_at") // one-shot ops alarm when auto-terminate HAI release fails
  terminationReason         String?   @map("termination_reason") @db.Text
  terminatedAt              DateTime? @map("terminated_at") // stamped when status transitions to "terminated"

  // Cancellation + refund (ops-entered amount, record-only — finance moves the
  // money out-of-band for BOTH payment modes; the app never moves funds).
  cancelledAt          DateTime? @map("cancelled_at")
  refundAmountCents    Int?      @map("refund_amount_cents") // ops-entered at cancel time; ≤ totalInvoiceCents
  refundReason         String?   @map("refund_reason") @db.Text
  refundReference      String?   @map("refund_reference") // outbound wire ref / Stripe refund id — MASKED, never a raw account #
  refundedAt           DateTime? @map("refunded_at")
  refundAgingAlertedAt DateTime? @map("refund_aging_alerted_at") // one-shot alarm when refund_pending ages past threshold

  // Region maintenance: when a paid order can't provision because its region is
  // in maintenance, startProvisioning leaves it payment_received and alerts ops
  // ONCE (this stamp). Reset to null on a successful claim so a future hold
  // re-alerts. The cron retries payment_received orders, so it self-heals.
  maintenanceHeldAlertedAt DateTime? @map("maintenance_held_alerted_at")

  // Server access (populated when provisioned)
  ipAddress  String? @map("ip_address")
  sshUser    String? @map("ssh_user")
  sshPort    Int?    @map("ssh_port")
  sshCommand String? @map("ssh_command")
  hostname   String?

  // Wire transfer receipt (uploaded by customer)
  receiptFileName   String?   @map("receipt_file_name")
  receiptUploadedAt DateTime? @map("receipt_uploaded_at")

  // Admin
  adminNotes String? @map("admin_notes") @db.Text
  updatedBy  String? @map("updated_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([stripeCustomerId])
  @@index([email])
  @@index([teamId])
  @@index([status])
  @@index([expiresAt])
  @@map("bare_metal_order")
}

// One provisioned HAI baremetal instance belonging to a BareMetalOrder. A
// multi-server order (serverCount > 1) fans out via HAI `quantity` into N of
// these — each an independent fulfillment with its own SSH/IP. The order goes
// "active" only when ALL its servers are Active (all-or-nothing); a partial
// failure holds the order for ops. Single-server orders have exactly one row.
model BareMetalServer {
  id                String         @id @default(cuid())
  orderId           String         @map("order_id")
  order             BareMetalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // HAI linkage (one HAI baremetal subscription/instance per row)
  haiSubscriptionId String? @map("hai_subscription_id")
  haiInstanceId     String? @map("hai_instance_id")
  label             String? // HAI instance name, e.g. "INV-BM-2026-XXXX-1"
  sequence          Int     @default(1) // 1..serverCount — stable ordering/labelling
  status            String  @default("Requested") // per-instance HAI status (Requested/Active/…)
  // PA-688: the PHYSICAL HAI baremetal node backing this fulfillment
  // (baremetal_subscriptions.node_id, same id space as the admin
  // /baremetal/node inventory). Nullable: unset until HAI assigns a node, and
  // unrecoverable for some legacy terminated orders. This is what makes a
  // machine's usage history across DIFFERENT customers answerable — without it
  // an order only maps to a HAI subscription, not to hardware.
  haiNodeId         Int?    @map("hai_node_id")

  // Server access — one server's worth (moved off the order's scalar columns)
  ipAddress       String?   @map("ip_address")
  sshUser         String?   @map("ssh_user")
  sshPort         Int?      @map("ssh_port")
  sshCommand      String?   @map("ssh_command")
  hostname        String?
  provisionedDate DateTime? @map("provisioned_date")
  provisionError  String?   @map("provision_error") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([haiNodeId]) // PA-688: per-node usage timeline groups by this
  @@map("bare_metal_server")
}

// PA-828: a HAI baremetal node explicitly retired from service, WITHOUT deleting
// it from the HAI admin panel. Before this, "retired" was only inferred from a
// node disappearing from HAI inventory (see retiredNode() in
// investor-baremetal.ts) — so retiring required a destructive delete of the very
// record the investor dashboard reads from. A marker row decouples the two: the
// node stays in inventory (available for firmware refresh + resale) while the
// dashboard reports it retired and keeps its revenue history intact.
//
// One row per node (haiNodeId is the PK, so the invariant is DB-enforced).
// Un-retiring = deleting the row (a node returning after a firmware refresh).
// Revenue is NOT stored here — it derives from BareMetalOrder rows, so retiring
// a node cannot alter historical figures by construction.
model RetiredBareMetalNode {
  haiNodeId Int      @id @map("hai_node_id") // HAI baremetal node id — same space as BareMetalServer.haiNodeId
  nodeName  String?  @map("node_name") // label captured at retire time (display convenience only)
  retiredAt DateTime @default(now()) @map("retired_at")
  retiredBy String   @map("retired_by") // admin email — audit trail
  note      String?  @db.Text // why it was retired (returned to DC, firmware refresh, …)

  @@map("retired_bare_metal_node")
}

// Region maintenance mode — admin marks a HAI region down for maintenance.
// One row per region (regionId is the PK, so the invariant is DB-enforced).
// While a row exists: new provisions into the region are blocked (customer +
// admin + cron) and existing instance cards hide actions + show a maintenance
// banner. Display-only for running pods (no auto-stop). Granularity is region,
// not pool: the GPU pool is HAI-chosen after the region gate and baremetal
// subscribes region-wide, so a pool id has no consumer here.
//
//   AVAILABLE ──admin toggle ON (confirm)──▶ IN_MAINTENANCE
//   (no row)  ◀──admin toggle OFF (delete)── (row exists)
//
// regionName/message are admin-authored; resolve the LIVE name from
// getAllRegions() at display time (the stored label can go stale on a HAI rename).
model RegionMaintenance {
  regionId   Int      @id @map("region_id") // HAI region id — same space as getAllRegions() / unified instance region.id
  regionName String?  @map("region_name") // label captured at toggle time (display convenience only)
  message    String?  @db.Text // customer-facing banner message; blank → default copy
  enabledBy  String   @map("enabled_by") // admin email — audit trail
  enabledAt  DateTime @default(now()) @map("enabled_at")

  @@map("region_maintenance")
}

model InferencePricingConfig {
  id                               String   @id @default("default")
  // Real-time pricing (per 1M tokens, in cents) - 50% of Together.ai
  realtimeInputPer1M               Int      @default(10) @map("realtime_input_per_1m") // $0.10 per 1M input tokens
  realtimeOutputPer1M              Int      @default(10) @map("realtime_output_per_1m") // $0.10 per 1M output tokens
  // Batch pricing (per 1M tokens, in cents) - discounted
  batch1hInputPer1M                Int      @default(7) @map("batch_1h_input_per_1m") // $0.07 per 1M - 30% discount
  batch1hOutputPer1M               Int      @default(7) @map("batch_1h_output_per_1m") // $0.07 per 1M
  batch24hInputPer1M               Int      @default(5) @map("batch_24h_input_per_1m") // $0.05 per 1M - 50% discount
  batch24hOutputPer1M              Int      @default(5) @map("batch_24h_output_per_1m") // $0.05 per 1M
  // Fine-tuning pricing
  fineTuningPer1kTokens            Int      @default(100) @map("fine_tuning_per_1k_tokens") // $1.00 per 1k training tokens
  loraStoragePerMonthCents         Int      @default(50) @map("lora_storage_per_month_cents") // $0.50 per LoRA per month
  // Playground
  playgroundFreeTierTokens         Int      @default(10000) @map("playground_free_tier_tokens") // Free tokens per day for playground
  // Provider revenue sharing (NEW)
  tokenProviderRevenueSharePercent Float    @default(50) @map("token_provider_revenue_share_percent") // Default 50% to providers
  // Settings
  enabled                          Boolean  @default(true)
  updatedAt                        DateTime @updatedAt @map("updated_at")
  updatedBy                        String?  @map("updated_by")

  @@map("inference_pricing_config")
}

// ============================================
// Wallet Transactions - Local billing log
// ============================================

model WalletTransaction {
  id               String   @id @default(cuid())
  stripeCustomerId String   @map("stripe_customer_id")
  teamId           String?  @map("team_id")
  type             String // "gpu_usage", "gpu_deploy", "storage", "stopped_reservation", "bare_metal", "token_inference", "refund"
  amountCents      Int      @map("amount_cents") // Positive = debit (charge), Negative = credit (refund)
  description      String   @db.Text
  subscriptionId   String?  @map("subscription_id") // GPUaaS subscription ID (links charge to a specific pod)
  poolId           Int?     @map("pool_id") // GPUaaS pool ID (links charge to a specific GPU pool -> investor node)
  gpuCount         Int?     @map("gpu_count")
  hourlyRateCents  Int?     @map("hourly_rate_cents")
  billingMinutes   Int?     @map("billing_minutes")
  syncCycleId      String?  @map("sync_cycle_id") // Deduplication ID
  metadata         String?  @db.Text // JSON for any extra context
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([stripeCustomerId, createdAt])
  @@index([teamId, createdAt])
  @@index([poolId, createdAt])
  @@index([subscriptionId, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
  @@index([syncCycleId])
  @@map("wallet_transaction")
}

model CampaignBanner {
