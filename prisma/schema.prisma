  slug   String @unique
  status String @default("active")

  // Contact (reseller admin)
  contactEmail String? @map("contact_email")
  contactName  String? @map("contact_name")

  // Branding
  brandName     String  @map("brand_name")
  logoUrl       String  @default("") @map("logo_url")
  faviconUrl    String? @map("favicon_url")
  ogImageUrl    String? @map("og_image_url")
  primaryColor  String  @default("#1a4fff") @map("primary_color")
  accentColor   String  @default("#18b6a8") @map("accent_color")
  bgColor       String  @default("#f7f8fb") @map("bg_color")
  textColor     String  @default("#0b0f1c") @map("text_color")
  customCss     String? @map("custom_css") @db.Text
  customStrings Json?   @map("custom_strings")

  // Their Stripe (encrypted at rest via src/lib/crypto.ts)
  stripeSecretKey      String @default("") @map("stripe_secret_key")
  stripePublishableKey String @default("") @map("stripe_publishable_key")
  stripeWebhookSecret  String @default("") @map("stripe_webhook_secret")

  // Our billing to them
  wholesaleCustomerId String? @map("wholesale_customer_id")

  // Pricing
  signupCreditCents Int    @default(0) @map("signup_credit_cents")
  billingModels     String @default("hourly,monthly") @map("billing_models")

  // Support & operations
  supportEmail      String  @default("") @map("support_email")
  supportUrl        String? @map("support_url")
  statusPageEnabled Boolean @default(true) @map("status_page_enabled")
  alertWebhookUrl   String? @map("alert_webhook_url")

  // GTM & integrations
  leadWebhookUrl   String? @map("lead_webhook_url")
  analyticsId      String? @map("analytics_id")
  dripEmailEnabled Boolean @default(true) @map("drip_email_enabled")

  // Access control
  adminDomains      String @default("hosted.ai") @map("admin_domains")
  allowedGpuTypes   String @default("rtx-pro-6000,b200,h200") @map("allowed_gpu_types")
  maxConcurrentGpus Int?   @map("max_concurrent_gpus")

  // API access (for WHMCS / custom integrations)
  apiKey     String? @unique @map("api_key")
  webhookUrl String? @map("webhook_url")

  // CLI
  cliName        String? @map("cli_name")
  cliDownloadUrl String? @map("cli_download_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  domains       TenantDomain[]
  gpuPricing    TenantGpuPricing[]
  customers     TenantCustomer[]
  dripTemplates TenantDripTemplate[]

  @@map("tenant")
}

model TenantDomain {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  domain     String    @unique
  isPrimary  Boolean   @default(false) @map("is_primary")
  verifiedAt DateTime? @map("verified_at")
  tenant     Tenant    @relation(fields: [tenantId], references: [id])

  @@index([domain])
  @@map("tenant_domain")
}

model TenantGpuPricing {
  id                 String  @id @default(cuid())
  tenantId           String  @map("tenant_id")
  gpuType            String  @map("gpu_type")
  hourlyRateCents    Int     @map("hourly_rate_cents")
  monthlyRateCents   Int?    @map("monthly_rate_cents")
  wholesaleCostCents Int     @map("wholesale_cost_cents")
  enabled            Boolean @default(true)
  tenant             Tenant  @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, gpuType])
  @@map("tenant_gpu_pricing")
}

model TenantCustomer {
  id                  String   @id @default(cuid())
  tenantId            String   @map("tenant_id")
  stripeCustomerId    String   @map("stripe_customer_id")
  email               String
  name                String?
  balanceCents        Int      @default(0) @map("balance_cents") // Positive = credit available
  walletEnabled       Boolean  @default(false) @map("wallet_enabled") // Whether wallet billing is active
  lowBalanceAlertSent Boolean  @default(false) @map("low_balance_alert_sent") // Prevent repeated low-balance webhooks
  createdAt           DateTime @default(now()) @map("created_at")
  tenant              Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, stripeCustomerId])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("tenant_customer")
}

// ============================================================
// TENANT WALLET TRANSACTIONS
// ============================================================

model TenantWalletTransaction {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  customerId     String   @map("customer_id")
  type           String // "credit" or "debit"
  amountCents    Int      @map("amount_cents")
  balanceAfter   Int      @map("balance_after")
  description    String
  idempotencyKey String?  @unique @map("idempotency_key")
  metadata       String?  @map("metadata") @db.Text // JSON stringified
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([customerId, createdAt])
  @@index([tenantId, createdAt])
  @@map("tenant_wallet_transaction")
}

// ============================================================
// WEBHOOK EVENT DELIVERY TRACKING
// ============================================================

model WebhookEvent {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  event       String
  payload     String // JSON stringified
  status      String    @default("pending") // pending, delivered, failed
  statusCode  Int?      @map("status_code")
  error       String?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  deliveredAt DateTime? @map("delivered_at")

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@map("webhook_event")
}

model TenantDripTemplate {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  emailType String   @map("email_type") // e.g. "gpu-1-inventory", "gpu-2-usecases", "gpu-3-credit", "api-1-quickstart", "api-2-features", "api-3-credit"
  subject   String
  bodyHtml  String   @map("body_html") @db.Text // custom HTML body content (not full layout, just the inner content)
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, emailType])
  @@index([tenantId])
  @@map("tenant_drip_template")
}

model AdminStatsSnapshot {
  id               String   @id @default(cuid())
  date             String   @unique // YYYY-MM-DD
  totalCustomers   Int      @map("total_customers")
  activeGPUs       Int      @map("active_gpus")
  mrrCents         Int      @map("mrr_cents")
  newThisWeek      Int      @map("new_this_week")
  revenueWeekCents Int      @map("revenue_week_cents")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("admin_stats_snapshot")
}

/// PA-693: daily fleet-capacity series — the denominator for "available
/// GPU-hours" (metrics sheet #11). One row per (date, kind, pool); baremetal is
/// a single fleet-wide row with poolId NULL. Written once per UTC day by the
/// refresh-pool-overview cron (first successful refresh after 00:00 UTC), so
/// history starts at ship date; earlier windows fall back to the current fleet.
model FleetCapacitySnapshot {
  id              String   @id @default(cuid())
  date            String // YYYY-MM-DD (UTC)
  kind            String // "pool" | "baremetal"
  poolId          Int?     @map("pool_id")
  gpuModel        String?  @map("gpu_model") // pool's dominant GPU model
  physicalGpus    Int      @map("physical_gpus")
  onlineGpus      Int      @map("online_gpus") // GPUs on initialized (online) nodes
  overcommitRatio Float    @default(1) @map("overcommit_ratio")
  vgpuSlots       Int      @map("vgpu_slots") // round(onlineGpus × overcommitRatio)
  onlineNodes     Int      @map("online_nodes")
  totalNodes      Int      @map("total_nodes")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([date, kind, poolId])
  @@index([date])
  @@map("fleet_capacity_snapshot")
}

// ── OSS Platform Settings (DB-backed config for self-hosted deployments) ──
model SystemSetting {
  key       String   @id
  value     String   @db.Text
  encrypted Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_setting")
}

model CustomerCache {
  id              String   @id // Stripe customer ID (cus_xxx)
  email           String?
  name            String?
  stripeCreatedAt DateTime @map("stripe_created_at")
  balanceCents    Int      @default(0) @map("balance_cents") // raw Stripe balance (negative = credit)
  billingType     String?  @map("billing_type")
  teamId          String?  @map("team_id") // metadata.hostedai_team_id
  productId       String?  @map("product_id") // metadata.packet_product_id
  metadataJson    String?  @map("metadata_json") @db.Text // full metadata JSON fallback
  activePods      Int      @default(0) @map("active_pods") // live pod count from hosted.ai
  isDeleted       Boolean  @default(false) @map("is_deleted")
  lastSyncedAt    DateTime @default(now()) @map("last_synced_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([billingType])
  @@index([teamId])
  @@index([stripeCreatedAt])
  @@map("customer_cache")
}

model AdminLoginLog {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  ip        String?
  method    String // "password" | "magic-link" | "invite-setup" | "2fa"
  reason    String? // null=success, "invalid-password" | "invalid-2fa" | "rate-limited"
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([createdAt])
  @@index([success])
  @@map("admin_login_log")
}

model GpuWaitlist {
  id               String   @id @default(cuid())
  email            String
  name             String?
  gpu              String // "b200", "h200", etc.
  useCase          String?  @map("use_case")
  expectedGpuHours String?  @map("expected_gpu_hours")
  source           String? // "gpu-b200-landing", etc.
  ip               String?
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([email, gpu])
  @@index([gpu])
  @@index([createdAt])
  @@map("gpu_waitlist")
}

model EmbargoLog {
  id        Int      @id @default(autoincrement())
  timestamp DateTime @default(now())
  ip        String   @db.VarChar(45)
  country   String?  @db.VarChar(2)
  action    String   @db.VarChar(10)
  reason    String   @db.VarChar(50)
  endpoint  String   @db.VarChar(255)
  email     String?  @db.VarChar(255)
  userAgent String?  @db.Text
  cfThreat  Int?     @map("cf_threat")

  @@index([timestamp])
  @@index([country])
  @@index([action])
  @@map("embargo_log")
}

model TosAcceptance {
  id               String   @id @default(cuid())
  stripeCustomerId String   @map("stripe_customer_id")
  tosVersion       String   @map("tos_version")
  acceptedAt       DateTime @default(now()) @map("accepted_at")
  ipAddress        String?  @map("ip_address")
  userAgent        String?  @map("user_agent") @db.Text

  @@unique([stripeCustomerId, tosVersion])
  @@index([stripeCustomerId])
  @@index([tosVersion])
  @@map("tos_acceptance")
}
