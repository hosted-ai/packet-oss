  batchJobs        InferenceBatchJob[]

  @@unique([teamId, name])
  @@index([stripeCustomerId])
  @@index([teamId])
  @@index([baseModelId])
  @@index([trainingStatus])
  @@map("lora_adapter")
}

model InferenceBatchJob {
  id                 String             @id @default(cuid())
